{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{src/**,node_modules/@google-cloud/firestore/build/protos/**,node_modules/farmhash-modern/bin/**}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index?__sehatRoute=healthz"
    },
    {
      "source": "/(adultEligibility|accountDeletion|syncUpload|syncPull|healthz)",
      "destination": "/api/index?__sehatRoute=$1"
    }
  ]
}
